$gpm-background: #0d0914;
$gpm-panel: #171120;
$gpm-panel-raised: #21172d;
$gpm-violet: #a855f7;
$gpm-lavender: #c4b5fd;
$gpm-text: #f5f3f7;
$gpm-muted: #9b93a6;
$gpm-green: #56c596;
$gpm-red: #ef6b73;
$gpm-amber: #e6b450;

Screen { background: $gpm-background; color: $gpm-text; layers: base overlay; }
#header { dock: top; height: 3; background: $gpm-panel-raised; border-bottom: solid $gpm-violet; padding: 0 1; }
#brand { width: 22; color: $gpm-lavender; text-style: bold; content-align: left middle; }
#basket-status { width: 34; color: $gpm-lavender; content-align: center middle; }
#storage { width: 1fr; color: $gpm-muted; content-align: right middle; }
#body { height: 1fr; }
.panel { background: $gpm-panel; border: round #49325e; border-title-color: $gpm-muted; }
.panel:focus-within { border: heavy $gpm-violet; border-title-color: $gpm-text; }
#categories { width: 22; min-width: 16; }
#categories OptionList { height: 1fr; background: $gpm-panel; border: none; }
#creator { dock: bottom; height: 3; color: $gpm-muted; text-align: center; content-align: center middle; border-top: solid #49325e; }
#categories OptionList > .option-list--option-highlighted { background: #4c1d70; color: $gpm-text; }
#categories OptionList:focus > .option-list--option-highlighted { background: $gpm-violet; color: $gpm-background; text-style: bold; }
#catalog { width: 2fr; min-width: 38; }
#auto-setup-guide { display: none; height: 2; padding: 0 1; background: $gpm-panel-raised; color: $gpm-muted; content-align: left middle; }
#package-table { height: 1fr; background: $gpm-panel; }
#package-table > .datatable--cursor { background: #5b2182; color: $gpm-text; }
#package-table:focus > .datatable--cursor { background: $gpm-violet; color: $gpm-background; text-style: bold; }
#details { width: 1fr; min-width: 26; padding: 1; color: $gpm-text; }
#details-title { height: 2; color: $gpm-lavender; text-style: bold; }
#details-body { height: 1fr; color: $gpm-muted; }
#setup-toggle-button { width: 1fr; height: 3; margin-top: 1; }
#tasks { dock: bottom; height: 7; background: $gpm-panel-raised; border-top: solid #49325e; }
#operation { height: 1; padding: 0 1; color: $gpm-lavender; }
#progress { height: 1; margin: 0 1; color: $gpm-violet; }
#logs { height: 1fr; padding: 0 1; background: $gpm-background; color: $gpm-muted; }
#search { dock: bottom; height: 3; display: none; border: round $gpm-violet; background: $gpm-panel-raised; }
#search.visible { display: block; }
Footer { background: $gpm-panel-raised; color: $gpm-muted; }
ModalScreen { align: center middle; background: rgba(13, 9, 20, 0.7); }
.modal { width: 64; max-width: 90%; height: auto; background: $gpm-panel-raised; border: round $gpm-violet; padding: 1 2; }
.modal-title { color: $gpm-lavender; text-style: bold; height: 2; }
.modal-buttons { height: 3; align: center middle; }
.modal-buttons Button { margin: 0 1; }
.modal-copy { color: $gpm-muted; height: auto; margin-bottom: 1; }
.welcome-modal { width: 72; }
.auto-setup-prompt-modal { width: 72; max-height: 90%; }
.auto-setup-progress-modal { width: 72; max-height: 90%; }
.auto-setup-prompt-modal #auto-setup-live-status { display: none; }
.auto-setup-prompt-modal #auto-setup-live-progress { display: none; }
.auto-setup-prompt-modal #auto-setup-live-note { display: none; }
.auto-setup-running .auto-setup-prompt-modal #auto-setup-live-status { display: block; height: 3; color: $gpm-text; padding: 1; background: $gpm-panel; }
.auto-setup-running .auto-setup-prompt-modal #auto-setup-live-progress { display: block; height: 1; margin: 1 0; color: $gpm-violet; }
.auto-setup-running .auto-setup-prompt-modal #auto-setup-live-note { display: block; height: auto; color: $gpm-muted; margin-bottom: 1; }
.auto-setup-running #auto-setup-prompt-list { max-height: 7; }
.auto-setup-progress-modal #auto-setup-live-status { height: 3; color: $gpm-text; padding: 1; background: $gpm-panel; }
.auto-setup-progress-modal #auto-setup-live-progress { height: 1; margin: 1 0; color: $gpm-violet; }
.auto-setup-progress-modal #auto-setup-live-note { height: auto; color: $gpm-muted; margin-bottom: 1; }
.quit-post-modal { width: 76; max-height: 90%; }
.quit-post-buttons Button { width: 1fr; margin: 0 1; }
#auto-setup-prompt-list { height: auto; max-height: 10; margin-bottom: 1; padding: 0 1; background: $gpm-panel; color: $gpm-text; }
.packs-modal { width: 72; height: 90%; max-height: 25; }
.packs-modal OptionList { height: 6; background: $gpm-panel; border: round #49325e; }
.packs-modal #pack-details { height: 1fr; min-height: 5; color: $gpm-muted; padding: 1; }
.basket-modal { width: 72; max-height: 90%; overflow-y: auto; }
.sort-modal { width: 44; height: 16; }
.sort-modal OptionList { height: 1fr; background: $gpm-panel; border: round #49325e; }
.summary-modal { width: 72; max-height: 90%; overflow-y: auto; }
.action-modal { width: 76; }
.removal-modal { width: 76; }
.action-buttons { height: 7; margin-top: 1; }
.action-button-row { height: 3; align: center middle; }
.action-button-row Button { width: 1fr; margin: 0 1; }
.doctor-modal { width: 78; height: 90%; max-height: 28; }
.doctor-modal DataTable { height: 1fr; background: $gpm-panel; }
#doctor-action { height: 3; color: $gpm-amber; padding: 1; }
#splash {
    layer: overlay;
    width: 100%;
    height: 100%;
    background: $gpm-background;
    color: $gpm-lavender;
    text-style: bold;
    text-align: center;
    content-align: center middle;
}

/* Theme classes live on the App so they also color modal screens and the
   built-in Ctrl+P command palette. Purple above remains the default. */
.theme-green Screen { background: #07110c; color: #f1f7f3; }
.theme-green #header, .theme-green #tasks, .theme-green Footer { background: #14251b; }
.theme-green #header { border-bottom: solid #22c55e; }
.theme-green .panel { background: #0d1a13; border: round #28533a; }
.theme-green .panel:focus-within { border: heavy #22c55e; }
.theme-green #categories OptionList, .theme-green #package-table, .theme-green #auto-setup-prompt-list { background: #0d1a13; color: #f1f7f3; }
.theme-green #categories OptionList > .option-list--option-highlighted,
.theme-green #package-table > .datatable--cursor { background: #166534; color: #f1f7f3; }
.theme-green #categories OptionList:focus > .option-list--option-highlighted,
.theme-green #package-table:focus > .datatable--cursor { background: #22c55e; color: #07110c; }
.theme-green #brand, .theme-green #basket-status, .theme-green #operation,
.theme-green .modal-title { color: #86efac; }
.theme-green #details-body, .theme-green #logs, .theme-green #creator { color: #94a39a; }
.theme-green #creator { border-top: solid #28533a; }
.theme-green #tasks { border-top: solid #28533a; }
.theme-green #progress { color: #22c55e; }
.theme-green #search, .theme-green .modal { background: #14251b; border: round #22c55e; }
.theme-green #splash { background: #07110c; color: #86efac; }
.theme-green Button.-primary { background: #22c55e; color: #07110c; }
.theme-green CommandPalette > Vertical { background: #22c55e 20%; }
.theme-green CommandPalette #--input { border: round #22c55e; }
.theme-green CommandList > .option-list--option-highlighted { background: #22c55e; color: #07110c; }

.theme-blue Screen { background: #070b14; color: #f2f6fc; }
.theme-blue #header, .theme-blue #tasks, .theme-blue Footer { background: #14213a; }
.theme-blue #header { border-bottom: solid #3b82f6; }
.theme-blue .panel { background: #0d1524; border: round #294a78; }
.theme-blue .panel:focus-within { border: heavy #3b82f6; }
.theme-blue #categories OptionList, .theme-blue #package-table, .theme-blue #auto-setup-prompt-list { background: #0d1524; color: #f2f6fc; }
.theme-blue #categories OptionList > .option-list--option-highlighted,
.theme-blue #package-table > .datatable--cursor { background: #1e3a8a; color: #f2f6fc; }
.theme-blue #categories OptionList:focus > .option-list--option-highlighted,
.theme-blue #package-table:focus > .datatable--cursor { background: #3b82f6; color: #070b14; }
.theme-blue #brand, .theme-blue #basket-status, .theme-blue #operation,
.theme-blue .modal-title { color: #93c5fd; }
.theme-blue #details-body, .theme-blue #logs, .theme-blue #creator { color: #94a3b8; }
.theme-blue #creator { border-top: solid #294a78; }
.theme-blue #tasks { border-top: solid #294a78; }
.theme-blue #progress { color: #3b82f6; }
.theme-blue #search, .theme-blue .modal { background: #14213a; border: round #3b82f6; }
.theme-blue #splash { background: #070b14; color: #93c5fd; }
.theme-blue Button.-primary { background: #3b82f6; color: #070b14; }
.theme-blue CommandPalette > Vertical { background: #3b82f6 20%; }
.theme-blue CommandPalette #--input { border: round #3b82f6; }
.theme-blue CommandList > .option-list--option-highlighted { background: #3b82f6; color: #070b14; }

.theme-black Screen { background: #030303; color: #f5f5f5; }
.theme-black #header, .theme-black #tasks, .theme-black Footer { background: #151515; }
.theme-black #header { border-bottom: solid #d4d4d4; }
.theme-black .panel { background: #0b0b0b; border: round #383838; }
.theme-black .panel:focus-within { border: heavy #d4d4d4; }
.theme-black #categories OptionList, .theme-black #package-table, .theme-black #auto-setup-prompt-list { background: #0b0b0b; color: #f5f5f5; }
.theme-black #categories OptionList > .option-list--option-highlighted,
.theme-black #package-table > .datatable--cursor { background: #404040; color: #f5f5f5; }
.theme-black #categories OptionList:focus > .option-list--option-highlighted,
.theme-black #package-table:focus > .datatable--cursor { background: #e5e5e5; color: #030303; }
.theme-black #brand, .theme-black #basket-status, .theme-black #operation,
.theme-black .modal-title { color: #d4d4d4; }
.theme-black #details-body, .theme-black #logs, .theme-black #creator { color: #a3a3a3; }
.theme-black #creator { border-top: solid #383838; }
.theme-black #tasks { border-top: solid #383838; }
.theme-black #progress { color: #d4d4d4; }
.theme-black #search, .theme-black .modal { background: #151515; border: round #d4d4d4; }
.theme-black #splash { background: #030303; color: #d4d4d4; }
.theme-black Button.-primary { background: #d4d4d4; color: #030303; }
.theme-black CommandPalette > Vertical { background: #d4d4d4 20%; }
.theme-black CommandPalette #--input { border: round #d4d4d4; }
.theme-black CommandList > .option-list--option-highlighted { background: #d4d4d4; color: #030303; }

.theme-red Screen { background: #120708; color: #fbf3f3; }
.theme-red #header, .theme-red #tasks, .theme-red Footer { background: #2b1517; }
.theme-red #header { border-bottom: solid #ef4444; }
.theme-red .panel { background: #201011; border: round #6b2b30; }
.theme-red .panel:focus-within { border: heavy #ef4444; }
.theme-red #categories OptionList, .theme-red #package-table, .theme-red #auto-setup-prompt-list { background: #201011; color: #fbf3f3; }
.theme-red #categories OptionList > .option-list--option-highlighted,
.theme-red #package-table > .datatable--cursor { background: #7f1d1d; color: #fbf3f3; }
.theme-red #categories OptionList:focus > .option-list--option-highlighted,
.theme-red #package-table:focus > .datatable--cursor { background: #ef4444; color: #120708; }
.theme-red #brand, .theme-red #basket-status, .theme-red #operation,
.theme-red .modal-title { color: #fca5a5; }
.theme-red #details-body, .theme-red #logs, .theme-red #creator { color: #b9a0a2; }
.theme-red #creator { border-top: solid #6b2b30; }
.theme-red #tasks { border-top: solid #6b2b30; }
.theme-red #progress { color: #ef4444; }
.theme-red #search, .theme-red .modal { background: #2b1517; border: round #ef4444; }
.theme-red #splash { background: #120708; color: #fca5a5; }
.theme-red Button.-primary { background: #ef4444; color: #120708; }
.theme-red CommandPalette > Vertical { background: #ef4444 20%; }
.theme-red CommandPalette #--input { border: round #ef4444; }
.theme-red CommandList > .option-list--option-highlighted { background: #ef4444; color: #120708; }

/* Textual's built-in Light mode changes its own widgets, but every custom
   surface above also needs a light counterpart. Keep the same layout and
   preserve the selected color theme as the accent. */
.-light-mode Screen { background: #f6f4f9; color: #292335; }
.-light-mode #header, .-light-mode #tasks, .-light-mode Footer { background: #eae5f0; color: #50475e; }
.-light-mode #header { border-bottom: solid #7c3aed; }
.-light-mode .panel { background: #fffdfd; border: round #b7a8c9; border-title-color: #655a70; }
.-light-mode .panel:focus-within { border: heavy #7c3aed; border-title-color: #292335; }
.-light-mode #categories OptionList, .-light-mode #package-table,
.-light-mode #auto-setup-prompt-list, .-light-mode .packs-modal OptionList,
.-light-mode .sort-modal OptionList, .-light-mode .doctor-modal DataTable {
    background: #fffdfd;
    color: #292335;
}
.-light-mode #categories OptionList > .option-list--option-highlighted,
.-light-mode #package-table > .datatable--cursor { background: #e7d8f7; color: #292335; }
.-light-mode #categories OptionList:focus > .option-list--option-highlighted,
.-light-mode #package-table:focus > .datatable--cursor { background: #7c3aed; color: #ffffff; text-style: bold; }
.-light-mode #brand, .-light-mode #basket-status, .-light-mode #operation,
.-light-mode #details-title, .-light-mode .modal-title { color: #5b21a1; }
.-light-mode #storage, .-light-mode #creator, .-light-mode #details-body,
.-light-mode #logs, .-light-mode .modal-copy, .-light-mode .packs-modal #pack-details { color: #51475f; }
.-light-mode #details { color: #292335; }
.-light-mode #creator, .-light-mode #tasks { border-top: solid #b7a8c9; }
.-light-mode #progress { color: #7c3aed; }
.-light-mode #logs { background: #f6f4f9; }
.-light-mode #search, .-light-mode .modal { background: #fffdfd; color: #292335; border: round #7c3aed; }
.-light-mode #splash { background: #f6f4f9; color: #5b21a1; }
.-light-mode ModalScreen { background: rgba(41, 35, 53, 0.35); }
.-light-mode Button.-primary { background: #7c3aed; color: #ffffff; }
.-light-mode Button.-default { background: #e3dce9; color: #292335; }
.-light-mode CommandPalette > Vertical { background: #fffdfd; }
.-light-mode CommandPalette #--input { border: round #7c3aed; background: #fffdfd; color: #292335; }
.-light-mode CommandList { background: #fffdfd; color: #292335; }
.-light-mode CommandList > .option-list--option-highlighted { background: #7c3aed; color: #ffffff; }

.-light-mode.theme-green #header, .-light-mode.theme-green #tasks, .-light-mode.theme-green Footer { background: #e5f1e8; }
.-light-mode.theme-green .panel { border: round #a4c7ad; }
.-light-mode.theme-green #header { border-bottom: solid #16803b; }
.-light-mode.theme-green .panel:focus-within { border: heavy #16803b; }
.-light-mode.theme-green #categories OptionList > .option-list--option-highlighted,
.-light-mode.theme-green #package-table > .datatable--cursor { background: #d6efdc; color: #243429; }
.-light-mode.theme-green #categories OptionList:focus > .option-list--option-highlighted,
.-light-mode.theme-green #package-table:focus > .datatable--cursor { background: #16803b; color: #ffffff; }
.-light-mode.theme-green #brand, .-light-mode.theme-green #basket-status,
.-light-mode.theme-green #operation, .-light-mode.theme-green #details-title,
.-light-mode.theme-green .modal-title { color: #116329; }
.-light-mode.theme-green #progress { color: #16803b; }
.-light-mode.theme-green #search, .-light-mode.theme-green .modal { border: round #16803b; }
.-light-mode.theme-green CommandPalette #--input { border: round #16803b; }
.-light-mode.theme-green Button.-primary, .-light-mode.theme-green CommandList > .option-list--option-highlighted { background: #16803b; color: #ffffff; }

.-light-mode.theme-blue #header, .-light-mode.theme-blue #tasks, .-light-mode.theme-blue Footer { background: #e5edf9; }
.-light-mode.theme-blue .panel { border: round #aabedb; }
.-light-mode.theme-blue #header { border-bottom: solid #2563bb; }
.-light-mode.theme-blue .panel:focus-within { border: heavy #2563bb; }
.-light-mode.theme-blue #categories OptionList > .option-list--option-highlighted,
.-light-mode.theme-blue #package-table > .datatable--cursor { background: #dce9fb; color: #253347; }
.-light-mode.theme-blue #categories OptionList:focus > .option-list--option-highlighted,
.-light-mode.theme-blue #package-table:focus > .datatable--cursor { background: #2563bb; color: #ffffff; }
.-light-mode.theme-blue #brand, .-light-mode.theme-blue #basket-status,
.-light-mode.theme-blue #operation, .-light-mode.theme-blue #details-title,
.-light-mode.theme-blue .modal-title { color: #174d96; }
.-light-mode.theme-blue #progress { color: #2563bb; }
.-light-mode.theme-blue #search, .-light-mode.theme-blue .modal { border: round #2563bb; }
.-light-mode.theme-blue CommandPalette #--input { border: round #2563bb; }
.-light-mode.theme-blue Button.-primary, .-light-mode.theme-blue CommandList > .option-list--option-highlighted { background: #2563bb; color: #ffffff; }

.-light-mode.theme-black #header, .-light-mode.theme-black #tasks, .-light-mode.theme-black Footer { background: #e8e8e8; }
.-light-mode.theme-black .panel { border: round #a9a9a9; }
.-light-mode.theme-black #header { border-bottom: solid #404040; }
.-light-mode.theme-black .panel:focus-within { border: heavy #404040; }
.-light-mode.theme-black #categories OptionList > .option-list--option-highlighted,
.-light-mode.theme-black #package-table > .datatable--cursor { background: #e1e1e1; color: #242424; }
.-light-mode.theme-black #categories OptionList:focus > .option-list--option-highlighted,
.-light-mode.theme-black #package-table:focus > .datatable--cursor { background: #404040; color: #ffffff; }
.-light-mode.theme-black #brand, .-light-mode.theme-black #basket-status,
.-light-mode.theme-black #operation, .-light-mode.theme-black #details-title,
.-light-mode.theme-black .modal-title { color: #303030; }
.-light-mode.theme-black #progress { color: #404040; }
.-light-mode.theme-black #search, .-light-mode.theme-black .modal { border: round #404040; }
.-light-mode.theme-black CommandPalette #--input { border: round #404040; }
.-light-mode.theme-black Button.-primary, .-light-mode.theme-black CommandList > .option-list--option-highlighted { background: #404040; color: #ffffff; }

.-light-mode.theme-red #header, .-light-mode.theme-red #tasks, .-light-mode.theme-red Footer { background: #f8e9e9; }
.-light-mode.theme-red .panel { border: round #dbb3b3; }
.-light-mode.theme-red #header { border-bottom: solid #b72e36; }
.-light-mode.theme-red .panel:focus-within { border: heavy #b72e36; }
.-light-mode.theme-red #categories OptionList > .option-list--option-highlighted,
.-light-mode.theme-red #package-table > .datatable--cursor { background: #f8dddd; color: #3b2729; }
.-light-mode.theme-red #categories OptionList:focus > .option-list--option-highlighted,
.-light-mode.theme-red #package-table:focus > .datatable--cursor { background: #b72e36; color: #ffffff; }
.-light-mode.theme-red #brand, .-light-mode.theme-red #basket-status,
.-light-mode.theme-red #operation, .-light-mode.theme-red #details-title,
.-light-mode.theme-red .modal-title { color: #92222b; }
.-light-mode.theme-red #progress { color: #b72e36; }
.-light-mode.theme-red #search, .-light-mode.theme-red .modal { border: round #b72e36; }
.-light-mode.theme-red CommandPalette #--input { border: round #b72e36; }
.-light-mode.theme-red Button.-primary, .-light-mode.theme-red CommandList > .option-list--option-highlighted { background: #b72e36; color: #ffffff; }
